# Beyond TV — exemplo de variáveis de ambiente do servidor.
# Somente valores fictícios. O .env real NUNCA vai para o git.
# Os argumentos de linha de comando (--port, --data-dir...) têm prioridade.

# Porta HTTP do dashboard, da API e do WebSocket.
BEYOND_PORT=8787

# Porta UDP em que as TVs procuram o servidor na rede (descoberta).
BEYOND_DISCOVERY_PORT=8788

# Pasta do banco, das mídias e dos logs (relativa ao diretório atual).
BEYOND_DATA_DIR=data

# Pasta do build do dashboard (saída de "flutter build web").
BEYOND_WEB_DIR=apps/dashboard/build/web

# Nível de log: debug, info, warning ou error.
BEYOND_LOG_LEVEL=info
